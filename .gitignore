google-services.json

# Firebase Crashlytics
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties

# ProGuard output
proguard/

# Log files
*.log

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride

# Windows metadata
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux metadata
*~

# Release build artifacts
*/release/
